node_modules/
.idea/
.DS_Store

# Generated LevelDB compendia, built from src/packs/ by `npm run build:packs`.
# The leading slash matters: an unanchored `packs/` matches at any depth and
# would also ignore src/packs/, the actual source of truth.
/packs/

# Screenshots and artifacts from tools/dev/smoke.mjs
/tools/dev/out/

# Generated landing page, built from site/ by `npm run build:site` and deployed
# to GitHub Pages by .github/workflows/pages.yml. The source is site/.
/_site/

# Raw game-icons.net source PNGs (staging). The shipped, class-named copies live
# in icons/; this folder is the untouched originals and is not part of the system.
/game-icons-dot-net/

# Generated translator TSVs, built from src/packs/ by `npm run i18n:extract`.
# The filled translations land in lang/*.json (UI) and lang/content/*.json.
/tools/i18n/tsv/

# Project context for Claude Code. Deliberately untracked: air-bladder is a
# public repo, and this file records candid working notes — deliberate deviations,
# things that turned out wrong, licensing caveats — that are useful locally and
# not something to publish.
/CLAUDE.md

# Staging area for replacement token art (tools/import/tokens-from-png.mjs)
new-tokens/
